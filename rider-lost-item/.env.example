# AgentDuet (1.0.0b9)
AGENTDUET_API_KEY=
AGENTDUET_CONNECTOR_UUID=

# WhatsApp inbox id — OPTIONAL for first run.
# Leave blank. Start the agent, text your *business* WhatsApp "hi" once —
# the agent prints READY and saves .wa_subscriber automatically.
# Only set this if you already know the Meta phone_number_id / AgentDuet WA
# subscriber (NOT +65… display, NOT the voice TELCO number):
# AGENTDUET_WA_SUBSCRIBER=

# Amazon Nova 2 Sonic (voice)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# AWS_SESSION_TOKEN=
# NOVA_SONIC_MODEL_ID=amazon.nova-2-sonic-v1:0
# NOVA_SONIC_VOICE_ID=matthew

# Pipedrive (omit token to mock CRM)
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=
# PIPEDRIVE_STAGE_ID=
