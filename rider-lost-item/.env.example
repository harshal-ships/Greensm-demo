# AgentDuet
AGENTDUET_API_KEY=
AGENTDUET_CONNECTOR_UUID=
# WhatsApp business identity (subscriber on WA messages) — NOT the TELCO voice number.
# Required for outbound WhatsApp. Using the voice-call subscriber causes inbox.NotFound.
# AGENTDUET_WA_SUBSCRIBER=+65XXXXXXXX

# Amazon Nova 2 Sonic
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Pipedrive (omit token to run in mock CRM mode)
PIPEDRIVE_API_TOKEN=
# Optional company subdomain, e.g. greensm → https://greensm.pipedrive.com
PIPEDRIVE_COMPANY_DOMAIN=
# Optional pipeline stage id for new lost-item deals
# PIPEDRIVE_STAGE_ID=
